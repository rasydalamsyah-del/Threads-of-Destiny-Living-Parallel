<?xml version="1.0" encoding="utf-8"?>
<!-- Panel gelap di bawah menu, dengan garis emas tipis di atasnya -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:startColor="#A6070D1E"
                android:centerColor="#D9060A18"
                android:endColor="#F2040710" />
        </shape>
    </item>
    <item android:gravity="top" android:height="1dp">
        <shape android:shape="rectangle">
            <gradient
                android:angle="0"
                android:startColor="#00C9A45C"
                android:centerColor="#FFE7C987"
                android:endColor="#00C9A45C" />
        </shape>
    </item>
</layer-list>
