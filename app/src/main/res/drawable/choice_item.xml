<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <gradient android:angle="270" android:startColor="#FFF8E3A8" android:endColor="#FFE2C27A" />
            <corners android:radius="18dp" />
            <stroke android:width="2dp" android:color="#FFB8913F" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient android:angle="270" android:startColor="#F5FFF9EC" android:endColor="#F2F6EBD2" />
            <corners android:radius="18dp" />
            <stroke android:width="1.5dp" android:color="#FFD2AE62" />
        </shape>
    </item>
</selector>
