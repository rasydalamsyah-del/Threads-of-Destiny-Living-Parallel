<?xml version="1.0" encoding="utf-8"?>
<!--
  Satu layar, tiga lapisan (dari bawah ke atas):
  1. menu_root : halaman utama (muncul setelah video selesai)
  2. video     : video intro
  3. splash    : gambar pembuka (3 detik)
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black"
    android:keepScreenOn="true">

    <!-- ===================== HALAMAN UTAMA ===================== -->
    <FrameLayout
        android:id="@+id/menu_root"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="invisible">

        <ImageView
            android:id="@+id/menu_bg"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="@null"
            android:scaleType="centerCrop"
            android:src="@drawable/menu_bg" />

        <com.valeriusgames.threadsofdestiny.SparkleView
            android:id="@+id/sparkles"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <!-- Judul -->
        <LinearLayout
            android:id="@+id/title_block"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="top"
            android:layout_marginTop="52dp"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingStart="18dp"
            android:paddingEnd="18dp">

            <com.valeriusgames.threadsofdestiny.GoldTitleView
                android:id="@+id/title_main"
                android:layout_width="match_parent"
                android:layout_height="72dp"
                android:autoSizeMaxTextSize="46sp"
                android:autoSizeMinTextSize="20sp"
                android:autoSizeStepGranularity="1sp"
                android:autoSizeTextType="uniform"
                android:fontFamily="@font/cinzel_decorative_bold"
                android:gravity="center"
                android:maxLines="1"
                android:shadowColor="#CC000000"
                android:shadowDy="2"
                android:shadowRadius="10"
                android:text="@string/title_main"
                android:textColor="#FFFFFFFF" />

            <View
                android:layout_width="220dp"
                android:layout_height="1dp"
                android:layout_marginTop="2dp"
                android:background="@drawable/title_divider" />

            <TextView
                android:id="@+id/title_sub"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:fontFamily="@font/cinzel"
                android:letterSpacing="0.06"
                android:shadowColor="#E6000000"
                android:shadowDy="2"
                android:shadowRadius="8"
                android:text="@string/title_sub"
                android:textColor="@color/cream"
                android:textSize="28sp" />
        </LinearLayout>

        <!-- Panel tombol -->
        <LinearLayout
            android:id="@+id/panel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:background="@drawable/menu_panel"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingTop="30dp"
            android:paddingBottom="18dp">

            <com.valeriusgames.threadsofdestiny.FantasyButton
                android:id="@+id/btn_start"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:layout_marginStart="52dp"
                android:layout_marginEnd="52dp"
                app:label="@string/btn_start"
                app:primary="true" />

            <com.valeriusgames.threadsofdestiny.FantasyButton
                android:id="@+id/btn_continue"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:layout_marginStart="52dp"
                android:layout_marginTop="14dp"
                android:layout_marginEnd="52dp"
                app:label="@string/btn_continue" />

            <com.valeriusgames.threadsofdestiny.FantasyButton
                android:id="@+id/btn_load"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:layout_marginStart="52dp"
                android:layout_marginTop="14dp"
                android:layout_marginEnd="52dp"
                app:label="@string/btn_load" />

            <com.valeriusgames.threadsofdestiny.FantasyButton
                android:id="@+id/btn_settings"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:layout_marginStart="52dp"
                android:layout_marginTop="14dp"
                android:layout_marginEnd="52dp"
                app:label="@string/btn_settings" />

            <TextView
                android:id="@+id/version"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:fontFamily="@font/cinzel"
                android:textColor="@color/version_text"
                android:textSize="12sp" />
        </LinearLayout>
    </FrameLayout>

    <!-- ===================== VIDEO INTRO ===================== -->
    <TextureView
        android:id="@+id/video"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0"
        android:contentDescription="@string/cd_skip_video" />

    <!-- ===================== GAMBAR SPLASH ===================== -->
    <ImageView
        android:id="@+id/splash"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/black"
        android:contentDescription="@null"
        android:scaleType="fitCenter"
        android:src="@drawable/splash" />

</FrameLayout>
