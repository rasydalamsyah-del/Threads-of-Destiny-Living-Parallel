<?xml version="1.0" encoding="utf-8"?>
<!--
  Layar permainan (visual novel). Lapisan dari bawah ke atas:
  background → efek kenangan → jam → kotak dialog → ikon HP
  → layar gelap → kelopak mata → teks waktu → layar HP → isi nama
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/game_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black"
    android:keepScreenOn="true">

    <FrameLayout
        android:id="@+id/bg_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <com.valeriusgames.threadsofdestiny.game.VignetteView
        android:id="@+id/vignette"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0" />

    <!-- Gambar karakter (kiri / tengah / kanan) -->
    <FrameLayout
        android:id="@+id/char_layer"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Jam (pojok kanan atas) -->
    <TextView
        android:id="@+id/clock"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_marginTop="34dp"
        android:layout_marginEnd="70dp"
        android:alpha="0"
        android:background="@drawable/clock_pill"
        android:elevation="2dp"
        android:fontFamily="sans-serif-medium"
        android:paddingStart="14dp"
        android:paddingTop="7dp"
        android:paddingEnd="14dp"
        android:paddingBottom="7dp"
        android:textColor="#FF2A2A2E"
        android:textSize="15sp" />

    <!-- Kotak dialog -->
    <FrameLayout
        android:id="@+id/dialog"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="132dp"
        android:alpha="0">

        <LinearLayout
            android:id="@+id/dialog_box"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:background="@drawable/dialog_light"
            android:elevation="3dp"
            android:orientation="vertical"
            android:paddingStart="22dp"
            android:paddingTop="26dp"
            android:paddingEnd="22dp"
            android:paddingBottom="14dp">

            <TextView
                android:id="@+id/dialog_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:lineSpacingMultiplier="1.18"
                android:minLines="3"
                android:textColor="#FF2A2A2E"
                android:textSize="18sp" />

            <TextView
                android:id="@+id/next_indicator"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="end"
                android:text="▼"
                android:textColor="#FFB08A45"
                android:textSize="12sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/name_tag"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:background="@drawable/name_tag_light"
            android:elevation="4dp"
            android:fontFamily="sans-serif-medium"
            android:paddingStart="16dp"
            android:paddingTop="6dp"
            android:paddingEnd="16dp"
            android:paddingBottom="6dp"
            android:textColor="#FF1E1E22"
            android:textSize="18sp"
            android:textStyle="bold" />
    </FrameLayout>

    <!-- Pilihan jawaban -->
    <LinearLayout
        android:id="@+id/choice_list"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="92dp"
        android:layout_marginBottom="22dp"
        android:orientation="vertical"
        android:visibility="gone" />

    <!-- Ikon HP + petunjuk -->
    <TextView
        android:id="@+id/phone_hint"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="84dp"
        android:layout_marginBottom="60dp"
        android:alpha="0"
        android:background="@drawable/hint_pill"
        android:elevation="3dp"
        android:fontFamily="sans-serif-medium"
        android:paddingStart="12dp"
        android:paddingTop="6dp"
        android:paddingEnd="12dp"
        android:paddingBottom="6dp"
        android:text="@string/phone_hint"
        android:textColor="#FF2A2A2E"
        android:textSize="13sp" />

    <com.valeriusgames.threadsofdestiny.game.PhoneIconView
        android:id="@+id/phone_icon"
        android:layout_width="70dp"
        android:layout_height="112dp"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="12dp"
        android:layout_marginBottom="14dp"
        android:visibility="gone" />

    <!-- Panel status kehidupan (pojok kiri atas) -->
    <com.valeriusgames.threadsofdestiny.life.LifeHudView
        android:id="@+id/life_hud"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|start"
        android:layout_marginStart="14dp"
        android:layout_marginTop="29dp"
        android:visibility="gone" />

    <!-- Panel karakter yang sedang bicara: foto, nama, tingkat hubungan, meter -->
    <LinearLayout
        android:id="@+id/char_panel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|start"
        android:layout_marginStart="14dp"
        android:layout_marginTop="29dp"
        android:alpha="0"
        android:background="@drawable/char_panel_bg"
        android:elevation="3dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="6dp"
        android:paddingTop="6dp"
        android:paddingEnd="14dp"
        android:paddingBottom="6dp"
        android:visibility="gone">

        <ImageView
            android:id="@+id/char_panel_photo"
            android:layout_width="58dp"
            android:layout_height="58dp"
            android:background="@drawable/oval_mask"
            android:clipToOutline="true"
            android:contentDescription="@null"
            android:scaleType="centerCrop" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/char_panel_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:textColor="#FF1E1E22"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/char_panel_stage"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#FF6B6B73"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/char_panel_meters"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:textColor="#FF2A2A2E"
                android:textSize="14sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Pemberitahuan singkat (lapar, haus, uang bertambah, dll.) -->
    <TextView
        android:id="@+id/life_notice"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginStart="24dp"
        android:layout_marginTop="150dp"
        android:layout_marginEnd="24dp"
        android:alpha="0"
        android:background="@drawable/hint_pill"
        android:elevation="6dp"
        android:gravity="center"
        android:paddingStart="16dp"
        android:paddingTop="9dp"
        android:paddingEnd="16dp"
        android:paddingBottom="9dp"
        android:textColor="#FF2A2A2E"
        android:textSize="14sp" />

    <!-- Tombol menu (burger), muncul di masa kini -->
    <ImageView
        android:id="@+id/btn_burger"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_gravity="top|end"
        android:layout_marginTop="29dp"
        android:layout_marginEnd="16dp"
        android:background="@drawable/burger_bg"
        android:contentDescription="@string/menu_title"
        android:elevation="3dp"
        android:padding="10dp"
        android:src="@drawable/ic_menu"
        android:visibility="gone" />

    <!-- Layar gelap untuk transisi -->
    <View
        android:id="@+id/black"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/black" />

    <com.valeriusgames.threadsofdestiny.game.EyelidView
        android:id="@+id/eyelid"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone" />

    <TextView
        android:id="@+id/timecard"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:alpha="0"
        android:fontFamily="@font/cinzel"
        android:gravity="center"
        android:letterSpacing="0.08"
        android:textColor="@color/cream"
        android:textSize="26sp" />

    <!-- ===================== LAYAR HP ===================== -->
    <FrameLayout
        android:id="@+id/phone_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#B3000000"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone">

        <FrameLayout
            android:id="@+id/phone_frame"
            android:layout_width="290dp"
            android:layout_height="590dp"
            android:layout_gravity="center"
            android:background="@drawable/phone_frame"
            android:clickable="true"
            android:elevation="12dp"
            android:padding="9dp">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/phone_screen"
                android:clipToOutline="true">

                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="@null"
                    android:scaleType="centerCrop"
                    android:src="@drawable/menu_bg" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="#59000000" />

                <View
                    android:layout_width="78dp"
                    android:layout_height="22dp"
                    android:layout_gravity="top|center_horizontal"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/phone_notch" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:paddingTop="38dp">

                    <!-- Layar utama HP -->
                    <LinearLayout
                        android:id="@+id/phone_home_page"
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="1"
                        android:gravity="center_horizontal"
                        android:orientation="vertical"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp">

                        <TextView
                            android:id="@+id/phone_date"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="sans-serif-medium"
                            android:shadowColor="#80000000"
                            android:shadowRadius="6"
                            android:textColor="#FFFFFFFF"
                            android:textSize="14sp" />

                        <TextView
                            android:id="@+id/phone_time"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="sans-serif-light"
                            android:includeFontPadding="false"
                            android:shadowColor="#80000000"
                            android:shadowRadius="8"
                            android:textColor="#FFFFFFFF"
                            android:textSize="44sp" />

                        <ScrollView
                            android:layout_width="match_parent"
                            android:layout_height="0dp"
                            android:layout_marginTop="12dp"
                            android:layout_weight="1"
                            android:overScrollMode="never"
                            android:scrollbars="none">

                            <LinearLayout
                                android:id="@+id/phone_notifs"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="vertical" />
                        </ScrollView>

                        <TextView
                            android:id="@+id/phone_empty"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="8dp"
                            android:text="@string/phone_empty"
                            android:textColor="#B3FFFFFF"
                            android:textSize="12sp" />

                        <LinearLayout
                            android:id="@+id/phone_apps"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="6dp"
                            android:orientation="vertical" />
                    </LinearLayout>

                    <!-- Halaman aplikasi -->
                    <LinearLayout
                        android:id="@+id/phone_app_page"
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="1"
                        android:background="@drawable/phone_app_bg"
                        android:orientation="vertical"
                        android:visibility="gone">

                        <FrameLayout
                            android:layout_width="match_parent"
                            android:layout_height="46dp">

                            <TextView
                                android:id="@+id/phone_app_back"
                                android:layout_width="44dp"
                                android:layout_height="match_parent"
                                android:gravity="center"
                                android:text="‹"
                                android:textColor="#FF2A2A2E"
                                android:textSize="28sp" />

                            <TextView
                                android:id="@+id/phone_app_title"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_gravity="center"
                                android:fontFamily="sans-serif-medium"
                                android:textColor="#FF16161A"
                                android:textSize="16sp"
                                android:textStyle="bold" />
                        </FrameLayout>

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:background="#1F000000" />

                        <ScrollView
                            android:id="@+id/phone_app_scroll"
                            android:layout_width="match_parent"
                            android:layout_height="0dp"
                            android:layout_weight="1"
                            android:clipToPadding="false"
                            android:paddingStart="10dp"
                            android:paddingTop="8dp"
                            android:paddingEnd="10dp"
                            android:paddingBottom="8dp">

                            <LinearLayout
                                android:id="@+id/phone_app_content"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="vertical" />
                        </ScrollView>

                        <LinearLayout
                            android:id="@+id/phone_app_footer"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:paddingStart="8dp"
                            android:paddingEnd="8dp"
                            android:paddingBottom="6dp" />
                    </LinearLayout>

                    <View
                        android:id="@+id/phone_home"
                        android:layout_width="120dp"
                        android:layout_height="5dp"
                        android:layout_marginTop="6dp"
                        android:layout_marginBottom="10dp"
                        android:background="@drawable/phone_home_bar" />
                </LinearLayout>
            </FrameLayout>
        </FrameLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|center_horizontal"
            android:layout_marginBottom="24dp"
            android:text="@string/phone_close_hint"
            android:textColor="#B3FFFFFF"
            android:textSize="13sp" />
    </FrameLayout>

    <!-- ===================== MENU (BURGER) ===================== -->
    <FrameLayout
        android:id="@+id/game_menu"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#B3000000"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone">

        <LinearLayout
            android:id="@+id/game_menu_card"
            android:layout_width="300dp"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:background="@drawable/panel_card"
            android:clickable="true"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingStart="18dp"
            android:paddingTop="22dp"
            android:paddingEnd="18dp"
            android:paddingBottom="18dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/cinzel"
                android:letterSpacing="0.12"
                android:text="@string/menu_title"
                android:textColor="@color/gold_light"
                android:textSize="22sp" />

            <View
                android:layout_width="160dp"
                android:layout_height="1dp"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="12dp"
                android:background="@drawable/title_divider" />

            <com.valeriusgames.threadsofdestiny.FantasyButton
                android:id="@+id/menu_resume"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                app:label="@string/menu_resume"
                app:primary="true" />

            <com.valeriusgames.threadsofdestiny.FantasyButton
                android:id="@+id/menu_save"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="8dp"
                app:label="@string/menu_save" />

            <com.valeriusgames.threadsofdestiny.FantasyButton
                android:id="@+id/menu_load"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="8dp"
                app:label="@string/menu_load" />

            <com.valeriusgames.threadsofdestiny.FantasyButton
                android:id="@+id/menu_log"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="8dp"
                app:label="@string/menu_log" />

            <com.valeriusgames.threadsofdestiny.FantasyButton
                android:id="@+id/menu_settings"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="8dp"
                app:label="@string/menu_settings" />

            <com.valeriusgames.threadsofdestiny.FantasyButton
                android:id="@+id/menu_main"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="8dp"
                app:label="@string/menu_main" />
        </LinearLayout>
    </FrameLayout>

    <!-- ===================== RIWAYAT DIALOG ===================== -->
    <LinearLayout
        android:id="@+id/log_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#EB060914"
        android:clickable="true"
        android:focusable="true"
        android:orientation="vertical"
        android:paddingTop="36dp"
        android:visibility="gone">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="20dp"
            android:paddingEnd="12dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:fontFamily="@font/cinzel"
                android:letterSpacing="0.1"
                android:text="@string/log_title"
                android:textColor="@color/gold_light"
                android:textSize="22sp" />

            <TextView
                android:id="@+id/log_close"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_gravity="end|center_vertical"
                android:gravity="center"
                android:text="✕"
                android:textColor="@color/cream"
                android:textSize="22sp" />
        </FrameLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/title_divider" />

        <ScrollView
            android:id="@+id/log_scroll"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:paddingStart="16dp"
            android:paddingTop="12dp"
            android:paddingEnd="16dp"
            android:paddingBottom="24dp">

            <LinearLayout
                android:id="@+id/log_list"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </ScrollView>
    </LinearLayout>

    <!-- ===================== LEMBAR SERBAGUNA (waktu bebas, status & tas, belanja) ===================== -->
    <FrameLayout
        android:id="@+id/sheet_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#B3000000"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone">

        <LinearLayout
            android:id="@+id/sheet_card"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginStart="14dp"
            android:layout_marginTop="56dp"
            android:layout_marginEnd="14dp"
            android:layout_marginBottom="28dp"
            android:background="@drawable/panel_card"
            android:clickable="true"
            android:orientation="vertical"
            android:paddingTop="18dp"
            android:paddingBottom="14dp">

            <TextView
                android:id="@+id/sheet_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/cinzel"
                android:gravity="center"
                android:letterSpacing="0.08"
                android:textColor="@color/gold_light"
                android:textSize="20sp" />

            <TextView
                android:id="@+id/sheet_sub"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:gravity="center"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:textColor="#CCE8E0CF"
                android:textSize="13sp" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/title_divider" />

            <ScrollView
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:clipToPadding="false"
                android:paddingStart="14dp"
                android:paddingTop="12dp"
                android:paddingEnd="14dp"
                android:paddingBottom="8dp">

                <LinearLayout
                    android:id="@+id/sheet_list"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />
            </ScrollView>

            <LinearLayout
                android:id="@+id/sheet_buttons"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="horizontal"
                android:paddingStart="12dp"
                android:paddingTop="8dp"
                android:paddingEnd="12dp" />
        </LinearLayout>
    </FrameLayout>

    <!-- ===================== MENINGGAL (GAME OVER) ===================== -->
    <LinearLayout
        android:id="@+id/death_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#FF000000"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingStart="36dp"
        android:paddingEnd="36dp"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/cinzel"
            android:letterSpacing="0.1"
            android:text="@string/death_title"
            android:textColor="#FFE0A0A0"
            android:textSize="30sp" />

        <View
            android:layout_width="180dp"
            android:layout_height="1dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/title_divider" />

        <TextView
            android:id="@+id/death_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center"
            android:lineSpacingMultiplier="1.25"
            android:textColor="@color/cream"
            android:textSize="16sp" />

        <com.valeriusgames.threadsofdestiny.FantasyButton
            android:id="@+id/death_load"
            android:layout_width="240dp"
            android:layout_height="56dp"
            android:layout_marginTop="36dp"
            app:label="@string/load_title"
            app:primary="true" />

        <com.valeriusgames.threadsofdestiny.FantasyButton
            android:id="@+id/death_menu"
            android:layout_width="240dp"
            android:layout_height="56dp"
            android:layout_marginTop="12dp"
            app:label="@string/menu_main" />
    </LinearLayout>

    <!-- ===================== ISI NAMA ===================== -->
    <FrameLayout
        android:id="@+id/name_entry"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clickable="true"
        android:focusable="true">

        <ImageView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="@null"
            android:scaleType="centerCrop"
            android:src="@drawable/menu_bg" />

        <View
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#C7050816" />

        <com.valeriusgames.threadsofdestiny.SparkleView
            android:id="@+id/name_sparkles"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <LinearLayout
            android:id="@+id/name_card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="150dp"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingStart="36dp"
            android:paddingEnd="36dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/cinzel"
                android:gravity="center"
                android:letterSpacing="0.04"
                android:shadowColor="#E6000000"
                android:shadowDy="2"
                android:shadowRadius="8"
                android:text="@string/name_title"
                android:textColor="@color/cream"
                android:textSize="28sp" />

            <View
                android:layout_width="180dp"
                android:layout_height="1dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/title_divider" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center"
                android:text="@string/name_subtitle"
                android:textColor="#CCE8E0CF"
                android:textSize="14sp" />

            <EditText
                android:id="@+id/name_input"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="28dp"
                android:autofillHints="name"
                android:background="@drawable/name_input_bg"
                android:fontFamily="@font/cinzel"
                android:gravity="center"
                android:hint="@string/name_hint"
                android:imeOptions="actionDone"
                android:inputType="textPersonName|textCapWords"
                android:maxLength="12"
                android:singleLine="true"
                android:textColor="@color/cream"
                android:textColorHint="#80E8E0CF"
                android:textCursorDrawable="@null"
                android:textSize="22sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="14dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/gender_male"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:fontFamily="@font/cinzel"
                    android:gravity="center"
                    android:text="@string/gender_male"
                    android:textSize="16sp" />

                <TextView
                    android:id="@+id/gender_female"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:fontFamily="@font/cinzel"
                    android:gravity="center"
                    android:text="@string/gender_female"
                    android:textSize="16sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/name_error"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/name_error"
                android:textColor="#FFFF8A8A"
                android:textSize="13sp"
                android:visibility="invisible" />

            <com.valeriusgames.threadsofdestiny.FantasyButton
                android:id="@+id/name_ok"
                android:layout_width="230dp"
                android:layout_height="60dp"
                android:layout_marginTop="10dp"
                app:label="@string/name_ok"
                app:primary="true" />
        </LinearLayout>
    </FrameLayout>

</FrameLayout>
